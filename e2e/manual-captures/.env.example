# Frontend ya levantado y API Laravel. No guardar credenciales reales.
MANUAL_CAPTURE_BASE_URL=http://127.0.0.1:3000
MANUAL_CAPTURE_API_URL=http://127.0.0.1:8000

# Opcionales: las rutas relativas se resuelven desde la raíz del frontend.
MANUAL_CAPTURE_BACKEND=../intranet_back
MANUAL_CAPTURE_MANIFEST=../intranet_back/resources/manual/capturas/manifest.json
MANUAL_CAPTURE_OUTPUT=../intranet_back/resources/manual/capturas

# Un par por cada rol habilitado en el manifiesto.
MANUAL_CAPTURE_COMERCIAL_USER=
MANUAL_CAPTURE_COMERCIAL_PASSWORD=

# Filtros opcionales, separados por coma.
MANUAL_CAPTURE_ROLE=
MANUAL_CAPTURE_SCREEN=
MANUAL_CAPTURE_SHOT=
